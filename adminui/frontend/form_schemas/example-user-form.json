{
	"form_data": {
		"name": "",
		"age": null
	},
	"json_schema": {
		"type": "object",
		"required": ["name", "age"],
		"properties": {
			"name": {
				"type": "string",
				"title": "Name",
				"minLength": 1
			},
			"age": {
				"type": "integer",
				"title": "Age",
				"minimum": 0,
				"maximum": 150
			}
		}
	},
	"ui_schema": {
		"type": "VerticalLayout",
		"elements": [
			{
				"type": "Control",
				"scope": "#/properties/name",
				"customComponent": "pkts-input-text"
			},
			{
				"type": "Control",
				"scope": "#/properties/age",
				"customComponent": "pkts-input-number"
			}
		]
	}
}
